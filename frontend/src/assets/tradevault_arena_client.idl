type ParticipantView = struct {
  tournament_id: u64,
  participant: actor_id,
  initial_virtual_balance: u128,
  realized_pnl: i128,
  unrealized_pnl: i128,
  final_value: i128,
  return_percentage_bps: i128,
  position: opt Position,
  claimable_reward: u128,
  last_close_reason: opt CloseReason,
  last_close_price: opt u128,
};

type Position = struct {
  entry_price: u128,
  size: u128,
  direction: PositionDirection,
  stop_loss_price: opt u128,
  take_profit_price: opt u128,
  is_open: bool,
};

type PositionDirection = enum {
  Long,
  Short,
};

type CloseReason = enum {
  Manual,
  StopLoss,
  TakeProfit,
};

type TournamentView = struct {
  tournament_id: u64,
  name: str,
  entry_fee: u128,
  start_time: u64,
  end_time: u64,
  initial_virtual_balance: u128,
  max_participants: u32,
  participant_count: u32,
  prize_pool: u128,
  status: TournamentStatus,
  final_btc_price: opt u128,
  winners: vec WinnerPayout,
};

type TournamentStatus = enum {
  Upcoming,
  Active,
  Ended,
  Settled,
};

type WinnerPayout = struct {
  rank: u8,
  participant: actor_id,
  payout: u128,
  final_value: i128,
  return_percentage_bps: i128,
};

type KeeperTickSummary = struct {
  price_updated: bool,
  positions_closed: u32,
  tournament_ended: bool,
  tournament_settled: bool,
};

type SettlementResult = struct {
  tournament_id: u64,
  final_btc_price: u128,
  prize_pool: u128,
  winners: vec WinnerPayout,
};

type LeaderboardEntry = struct {
  rank: u8,
  participant: actor_id,
  final_value: i128,
  realized_pnl: i128,
  unrealized_pnl: i128,
  return_percentage_bps: i128,
  position: opt Position,
};

constructor {
  Create : (initial_btc_price: u128);
};

service TradevaultArena {
  AddKeeper : (keeper: actor_id) -> bool;
  ClaimReward : (tournament_id: u64) -> u128;
  ClosePosition : (tournament_id: u64) -> ParticipantView;
  CreateTournament : (name: str, entry_fee: u128, start_time: u64, end_time: u64, initial_virtual_balance: u128, max_participants: u32) -> TournamentView;
  EndTournament : (tournament_id: u64) -> TournamentView;
  JoinTournament : (tournament_id: u64) -> ParticipantView;
  KeeperTick : (tournament_id: u64, new_btc_price: u128) -> KeeperTickSummary;
  OpenPosition : (tournament_id: u64, direction: PositionDirection, size: u128, stop_loss_price: opt u128, take_profit_price: opt u128) -> ParticipantView;
  ProcessTournament : (tournament_id: u64) -> KeeperTickSummary;
  RemoveKeeper : (keeper: actor_id) -> bool;
  SettleTournament : (tournament_id: u64) -> SettlementResult;
  UpdateMockPrice : (new_price: u128) -> u128;
  UpdatePriceAndProcess : (tournament_id: u64, new_btc_price: u128) -> KeeperTickSummary;
  query Admin : () -> actor_id;
  query CurrentMockPrice : () -> u128;
  query IsKeeper : (address: actor_id) -> bool;
  query Keepers : () -> vec actor_id;
  query LastPriceUpdateTime : () -> u64;
  query Leaderboard : (tournament_id: u64) -> vec LeaderboardEntry;
  query MaxStaleMs : () -> u64;
  query Participant : (tournament_id: u64, participant: actor_id) -> ParticipantView;
  query Tournament : (tournament_id: u64) -> TournamentView;
  query Tournaments : () -> vec TournamentView;

  events {
    TournamentCreated: struct {
      tournament_id: u64,
      name: str,
    };
    TournamentJoined: struct {
      tournament_id: u64,
      participant: actor_id,
      prize_pool: u128,
    };
    MockPriceUpdated: struct {
      price: u128
    };
    PriceUpdated: struct {
      tournament_id: u64,
      price: u128,
      timestamp: u64,
    };
    KeeperAdded: struct {
      keeper: actor_id
    };
    KeeperRemoved: struct {
      keeper: actor_id
    };
    PositionOpened: struct {
      tournament_id: u64,
      participant: actor_id,
      direction: PositionDirection,
      size: u128,
      entry_price: u128,
      stop_loss_price: opt u128,
      take_profit_price: opt u128,
    };
    PositionClosed: struct {
      tournament_id: u64,
      participant: actor_id,
      realized_pnl: i128,
      exit_price: u128,
      close_reason: CloseReason,
    };
    StopLossTriggered: struct {
      tournament_id: u64,
      participant: actor_id,
      trigger_price: u128,
    };
    TakeProfitTriggered: struct {
      tournament_id: u64,
      participant: actor_id,
      trigger_price: u128,
    };
    TournamentEnded: struct {
      tournament_id: u64,
      final_btc_price: u128,
    };
    TournamentSettled: struct {
      tournament_id: u64,
      winners: vec WinnerPayout,
    };
    KeeperTickProcessed: struct {
      tournament_id: u64,
      positions_closed: u32,
      tournament_ended: bool,
      tournament_settled: bool,
    };
    RewardClaimed: struct {
      tournament_id: u64,
      participant: actor_id,
      payout: u128,
    };
  }
};

